## Slack App credentials (https://api.slack.com/apps → your app)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/oauth/callback

## Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

## Linkup (https://app.linkup.so) — used for company resolution wizard + grounded enrichment.
## Optional fallback when a workspace doesn't have its own key set. All calls run depth='deep'.
LINKUP_API_KEY=

## Supabase (https://supabase.com/dashboard → Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

## Inngest (https://app.inngest.com → Event Keys / Signing Key)
## Optional in dev (the Inngest dev server doesn't need them).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

## 32+ chars random string. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

## Public app URL (used for OAuth redirect, CORS, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
